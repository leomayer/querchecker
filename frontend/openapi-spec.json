  "components": {
    "schemas": {
      "PreferenceRequest": {
        "type": "object",
        "properties": { "fieldKeys": { "type": "array", "items": { "type": "string" } } }
      },
      "PreferenceResponse": {
        "type": "object",
        "properties": {
          "categoryId": { "type": "integer", "format": "int64" },
          "categoryName": { "type": "string" },
          "fieldKeys": { "type": "array", "items": { "type": "string" } }
        }
      },
      "WhCategoryDto": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "whId": { "type": "integer", "format": "int32" },
          "name": { "type": "string" },
          "level": { "type": "integer", "format": "int32" },
          "children": { "type": "array", "items": { "$ref": "#/components/schemas/WhCategoryDto" } }
        }
      },
      "WhDetailDto": {
        "type": "object",
        "properties": {
          "whItemId": { "type": "integer", "format": "int64" },
          "id": { "type": "integer", "format": "int64" },
          "whId": { "type": "string" },
          "title": { "type": "string" },
          "price": { "type": "number" },
          "location": { "type": "string" },
          "url": { "type": "string" },
          "listedAt": { "type": "string", "format": "date-time" },
          "fetchedAt": { "type": "string", "format": "date-time" },
          "paylivery": { "type": "boolean" },
          "categoryPath": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/WhCategoryDto" }
          },
          "description": { "type": "string" },
          "previews": { "type": "array", "items": { "$ref": "#/components/schemas/WhPreviewDto" } },
          "note": { "type": "string" },
          "rating": { "type": "string" },
          "interestLevel": { "type": "string" },
          "viewCount": { "type": "integer", "format": "int32" },
          "lastViewedAt": { "type": "string", "format": "date-time" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "WhPreviewDto": {
        "type": "object",
        "properties": { "thumbUrl": { "type": "string" }, "fullUrl": { "type": "string" } }
      },
      "DlSettingsDto": {
        "type": "object",
        "properties": { "contextMaxTokens": { "type": "integer", "format": "int32" } }
      },
      "ProviderSetupSaveRequest": {
        "type": "object",
        "properties": {
          "secrets": { "type": "object", "additionalProperties": { "type": "string" } },
          "config": { "type": "object", "additionalProperties": { "type": "string" } },
          "searchProvider": { "type": "string" },
          "llmProvider": { "type": "string" }
        }
      },
      "WhItemDto": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "whId": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "price": { "type": "number" },
          "location": { "type": "string" },
          "url": { "type": "string" },
          "listedAt": { "type": "string", "format": "date-time" },
          "fetchedAt": { "type": "string", "format": "date-time" },
          "thumbnailUrl": { "type": "string" },
          "imageUrls": { "type": "array", "items": { "type": "string" } },
          "hasNote": { "type": "boolean" },
          "viewCount": { "type": "integer", "format": "int32" },
          "lastViewedAt": { "type": "string", "format": "date-time" },
          "rating": { "type": "string" },
          "interestLevel": { "type": "string" },
          "paylivery": { "type": "boolean" },
          "categoryPath": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/WhCategoryDto" }
          }
        }
      },
      "LookupRequest": { "type": "object", "properties": { "lookupTerm": { "type": "string" } } },
      "LookupHistoryEntryDto": {
        "type": "object",
        "properties": {
          "lookupTerm": { "type": "string" },
          "lookupStatus": {
            "type": "string",
            "enum": ["COMPLETE", "FAILED", "QUOTA_EXCEEDED", "NO_SOURCES", "ERROR", "RATE_LIMITED"]
          },
          "quickFacts": { "type": "object", "additionalProperties": { "type": "string" } },
          "icecatId": { "type": "string" },
          "sourceType": {
            "type": "string",
            "enum": ["ICECAT", "FLATPANELSHD", "GSMARENA", "GENERIC"]
          },
          "sourceDomain": { "type": "string" },
          "siteLabel": { "type": "string" },
          "sourceUrl": { "type": "string" },
          "featureGroupsJson": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "LookupResponse": {
        "type": "object",
        "properties": {
          "lookupStatus": {
            "type": "string",
