          },
          {
            "name": "priceTo",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int32" }
          },
          {
            "name": "attributeTree",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int32" }
          },
          {
            "name": "areaId",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int32" }
          },
          { "name": "paylivery", "in": "query", "required": false, "schema": { "type": "boolean" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/WhSearchResultDto" } } }
          }
        }
      }
