<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- EI / EI2: Lombok @Data classes intentionally expose mutable references —
       all classes are Spring-managed beans or internal DTOs, not public API. -->
  <Match>
    <Bug code="EI,EI2" />
  </Match>

  <!-- CT_CONSTRUCTOR_THROW: TokenAnalyzer is an internal utility class, not a library type.
       Finalizer attack is not a concern for non-public internal classes. -->
  <Match>
    <Class name="at.querchecker.deepLearning.TokenAnalyzer" />
    <Bug pattern="CT_CONSTRUCTOR_THROW" />
  </Match>

  <!-- VA_PRIMITIVE_ARRAY_PASSED_TO_OBJECT_VARARG: OnnxTensor.createTensor() requires
       wrapping primitive arrays in Object varargs — this is the correct ONNX Runtime API usage. -->
  <Match>
    <Class name="at.querchecker.deepLearning.service.AbstractExtractionModel" />
    <Bug pattern="VA_PRIMITIVE_ARRAY_PASSED_TO_OBJECT_VARARG" />
  </Match>

  <!-- NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE: RestTemplate.exchange() is guaranteed non-null
       by the Spring contract — SpotBugs cannot infer this from the return type alone. -->
  <Match>
    <Class name="at.querchecker.willHaben.WhApiClient" />
    <Method name="fetchApplicationToken" />
    <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE" />
  </Match>
</FindBugsFilter>
